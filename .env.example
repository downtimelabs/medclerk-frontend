# MedClerk Frontend Environment Variables

# API Configuration
# Production backend (default)
VITE_API_URL=https://medclerk-backend.vercel.app/api/v1

# Local development backend (uncomment if running backend locally)
# VITE_API_URL=http://localhost:3000/api/v1

# Alternative backend URL (if production is down)
# VITE_API_URL=https://your-alternative-backend.com/api/v1

# Development settings
VITE_ENV=development
